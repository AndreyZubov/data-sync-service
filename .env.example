# Copy to .env and fill in. .env is git-ignored.

# --- HTTP control API ---
HTTP_ADDR=:8080
# Grace period for in-flight requests and active runs on shutdown (Go duration).
# Runs that already have a Salesforce job are resumed at the next start.
SHUTDOWN_TIMEOUT=15s

# --- Salesforce connected app (OAuth client credentials) ---
# Required. See "Salesforce setup" in README.md.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# The org's My Domain URL (Setup > My Domain). login.salesforce.com and
# test.salesforce.com do not support the client credentials flow.
SF_LOGIN_URL=https://your-domain.my.salesforce.com
SF_API_VERSION=60.0
# Assumed token lifetime when Salesforce does not state one; keep it below the
# connected app's session timeout.
SF_TOKEN_TTL=30m

# --- PostgreSQL ---
# Required. Matches the local container in docker-compose.yml. Migrations run at
# startup.
DATABASE_URL=postgres://sync:sync@localhost:5432/sync?sslmode=disable

# --- Sync behaviour ---
# Comma-separated "Object:cron" pairs, e.g. Account:*/15 * * * *,Contact:0 * * * *
# Only objects listed here are synced on schedule and accepted by the
# /sync/{object}/... endpoints. Every tick exports the object and, if it has due
# outbox entries, imports them. Schedules use the server's local time zone.
SYNC_OBJECTS=
# Runs executing at once; further runs wait queued.
MAX_CONCURRENT_JOBS=4
# Salesforce requests per second, retries and job polling included.
API_RATE_LIMIT=10
# No new run starts once the org has used this percentage of its daily API
# requests, which all its integrations share; 0 turns the check off.
API_USAGE_THRESHOLD=80
# Upsert workers per run.
WORKER_COUNT=4
# Outbox entries one import run sends at most.
IMPORT_MAX_RECORDS=10000
# Import runs that may try an outbox entry before it is dead-lettered.
IMPORT_MAX_ATTEMPTS=5

# --- Observability ---
# debug | info | warn | error
LOG_LEVEL=info
