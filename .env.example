# Copy to .env and fill in. .env is git-ignored.

# --- HTTP control API ---
HTTP_ADDR=:8080
# Grace period for in-flight requests on shutdown (Go duration).
SHUTDOWN_TIMEOUT=15s

# --- Salesforce connected app (OAuth client credentials) ---
# Required. See "Salesforce setup" in README.md.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# The org's My Domain URL (Setup > My Domain). login.salesforce.com and
# test.salesforce.com do not support the client credentials flow.
SF_LOGIN_URL=https://your-domain.my.salesforce.com
SF_API_VERSION=60.0
# Assumed token lifetime when Salesforce does not state one; keep it below the
# connected app's session timeout.
SF_TOKEN_TTL=30m

# --- PostgreSQL ---
# Matches the local container in docker-compose.yml.
DATABASE_URL=postgres://sync:sync@localhost:5432/sync?sslmode=disable

# --- Sync behaviour ---
# Comma-separated "Object:cron" pairs, e.g. Account:*/15 * * * *,Contact:0 * * * *
# Only objects listed here are accepted by the /sync/{object}/... endpoints.
SYNC_OBJECTS=
MAX_CONCURRENT_JOBS=4
API_RATE_LIMIT=10
WORKER_COUNT=4

# --- Observability ---
# debug | info | warn | error
LOG_LEVEL=info
